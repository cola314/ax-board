{
  "me": {"name": "홍길동", "aliases": ["길동"]},
  "port": 8790,
  "features": {"teams": false, "gmail": false, "gitlab": false, "calendar": false, "flex": false, "status": true, "review_check": true},
  "gitlab": {"host": "gitlab.example.com", "username": "your-id", "cli": "glab", "branch_prefix": "feature/your-id"},
  "gmail": {
    "window_title_regex": "you@example\\.com - .* 메일",
    "chrome_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "chrome_profile": "Default",
    "url": "https://mail.google.com/mail/u/0/#inbox"
  },
  "repos": {"sources_dir": "sources"},
  "todo": {"file": "TODO.md", "section": "🔥 진행 중"},
  "flex": {"user_key": "YOUR_FLEX_USER_KEY"},
  "review_check": {"times": ["11:30", "17:00"]},
  "news": {
    "key_patterns": [
      "/([\\w.-]+)/-/(?:work_items|issues)/(\\d+)",
      "^(?:Re: )?([\\w.-]+) \\|.*\\(#(\\d+)\\)",
      "\\b(myproj-[\\w-]+)\\s*#(\\d+)"
    ],
    "default_project": "myproj-backend"
  },
  "dashboard": {
    "assistant": "비서",
    "key_strip": "^myproj-",
    "meeting_strip": "^우리팀\\s*",
    "quick": [["답장 초안", "답장 초안 만들어줘"], ["요약", "무슨 얘기인지 한 줄로"]],
    "gitlab_quick": [["요약", "무슨 변경인지 한 줄로"]],
    "short": [["yes", "ㅇㅇ ㄱㄱ"], ["no", "아니"], ["summary", "결론만 한 줄로"], ["retry", "다시 시도"]],
    "review_hint": "보시고 괜찮으면 푸시해 달라고 말해 주세요"
  },
  "rules": {"file": "docs/secretary-rules.md"}
}
